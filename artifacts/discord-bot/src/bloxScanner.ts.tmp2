import type { Client, Message, Attachment } from 'discord.js';
import { EmbedBuilder, Events, PermissionFlagsBits, SlashCommandBuilder } from 'discord.js';
import type { Command } from './types.js';
import { claimMessageEvent, loadGuild, updateGuild } from './storage.js';
import { BLOX_VALUES, findBloxValue } from './commands/bloxvalue.js';

type Item={name:string;quantity:number;permanent:boolean;confidence:number}; type Result={left:Item[];right:Item[]}; type Saved={url:string;messageId:string;createdAt:number};
const KEY=Symbol.for('sparxie.bloxscanner.registered'); const MAX=15*1024*1024;
const catalog=BLOX_VALUES.map((x:any)=>x.name).filter(Boolean).join(', ');
const image=(a:Attachment)=>Boolean(a.contentType?.startsWith('image/'))||/\.(png|jpe?g|webp)$/i.test(a.name??'');
const ss=(s:string)=>/^(?:\.|!)?ss$/i.test(s.trim());
function val(s:string){const m=String(s).replace(/,/g,'').trim().toUpperCase().match(/^(\d+(?:\.\d+)?)([KMBT])?$/);if(!m)return null;const n=Number(m[1]),k=m[2];return n*(k==='K'?1e3:k==='M'?1e6:k==='B'?1e9:k==='T'?1e12:1)}
function demand(s?:string){const m=String(s??'').match(/(\d+(?:\.\d+)?)\s*\/\s*10/);return m?Math.max(0,Math.min(10,Number(m[1]))):null}
function money(n:number){const a=Math.abs(n);if(a>=1e12)return `${(n/1e12).toFixed(2).replace(/\.00$/,'')}T`;if(a>=1e9)return `${(n/1e9).toFixed(2).replace(/\.00$/,'')}B`;if(a>=1e6)return `${(n/1e6).toFixed(2).replace(/\.00$/,'')}M`;if(a>=1e3)return `${(n/1e3).toFixed(1).replace(/\.0$/,'')}K`;return Math.round(n).toLocaleString('en-US')}
function resolve(i:Item){const e=findBloxValue(i.name);if(!e)return null;const q=Math.max(1,Math.min(50,Math.round(i.quantity||1)));const p=Boolean(i.permanent);const u=p&&e.perm&&e.perm!=='—'&&e.perm!=='N/A'?val(e.perm):val(e.regular);if(u===null)return null;return{entry:e,quantity:q,permanent:p,unit:u,demand:demand(e.demand),confidence:i.confidence}}
function totals(items:Item[]){const rows:any[]=[],unknown:string[]=[];let raw=0,score=0,ds=0,dc=0;for(const i of items){const r=resolve(i);if(!r){unknown.push(i.name);continue}const total=r.unit*r.quantity;const mult=r.demand==null?.85:0.70+0.03*r.demand;raw+=total;score+=total*mult;if(r.demand!=null){ds+=r.demand;dc++}rows.push({...r,total})}return{rows,unknown,raw,score,avg:dc?ds/dc:null}}
function verdict(l:number,r:number){if(!l&&!r)return['FAIR',1]as const;if(!r)return[l?'L':'FAIR',Infinity]as const;if(!l)return['W',0]as const;const x=l/r;return x>=.9&&x<=1.1?['FAIR',x]as const:x<1?['W',x]as const:['L',x]as const}
function embed(uid:string,res:Result){const l=totals(res.left),r=totals(res.right),[v,ratio]=verdict(l.score,r.score);const lines=(x:ReturnType<typeof totals>)=>x.rows.length?x.rows.map(i=>`${i.quantity>1?`${i.quantity}x `:''}${i.entry.name}${i.permanent?' (Perm)':''} — **${money(i.total)}** · Demand **${i.demand==null?'N/A':`${i.demand}/10`}**`).join('\n'):'None detected';const e=new EmbedBuilder().setTitle(`🔎 Trade Scanner — ${v}`).setColor(v==='W'?0x2ecc71:v==='L'?0xe74c3c:0xf1c40f).setDescription(`**<@${uid}>** uploaded the screenshot. **LEFT = uploader. RIGHT = other trader.**`).addFields({name:'👈 LEFT / YOUR TRADE',value:`${lines(l)}\n\n**Raw value:** ${money(l.raw)}\n**Demand-adjusted:** ${money(l.score)}\n**Average demand:** ${l.avg==null?'N/A':`${l.avg.toFixed(1)}/10`}`.slice(0,1024)},{name:'👉 RIGHT / OTHER TRADE',value:`${lines(r)}\n\n**Raw value:** ${money(r.raw)}\n**Demand-adjusted:** ${money(r.score)}\n**Average demand:** ${r.avg==null?'N/A':`${r.avg.toFixed(1)}/10`}`.slice(0,1024)},{name:'🏆 FINAL ANSWER',value:`# **${v}**\nRatio: **${Number.isFinite(ratio)?(ratio*100).toFixed(1)+'%':'∞'}**\nRaw difference: **${money(l.raw-r.raw)}**\nDemand difference: **${money(l.score-r.score)}**`});const u=[...l.unknown,...r.unknown];if(u.length)e.addFields({name:'⚠️ Unmatched / needs review',value:[...new Set(u)].slice(0,10).map(x=>`• ${x}`).join('\n').slice(0,1024)});return e}
async function download(url:string){const c=new AbortController(),t=setTimeout(()=>c.abort(),20000);try{const r=await fetch(url,{signal:c.signal});if(!r.ok)throw Error(`Discord image ${r.status}`);const b=await r.arrayBuffer();if(b.byteLength>MAX)throw Error('Image too large');const m=(r.headers.get('content-type')||'image/jpeg').split(';')[0];return{mime:m.startsWith('image/')?m:'image/jpeg',data:Buffer.from(b).toString('base64')}}finally{clearTimeout(t)}}
function json(text:string):Result{const s=text.trim().replace(/^```(?:json)?/i,'').replace(/```$/i,'').trim(),a=s.indexOf('{'),b=s.lastIndexOf('}');if(a<0||b<=a)throw Error('Invalid Gemini JSON');const d=JSON.parse(s.slice(a,b+1))as any;const side=(v:any):Item[]=>Array.isArray(v)?v.map((x:any)=>({name:typeof x?.name==='string'?x.name.trim():'',quantity:Math.max(1,Math.min(50,Math.round(Number(x?.quantity??1)))),permanent:Boolean(x?.permanent),confidence:Math.max(0,Math.min(1,Number(x?.confidence??0)))})).filter(x=>x.name):[];return{left:side(d.left),right:side(d.right)}}
async function analyze(url:string):Promise<Result>{const key=process.env.GEMINI_API_KEY?.trim();if(!key)throw Error('GEMINI_API_KEY missing');const img=await download(url);const model=process.env.GEMINI_SCANNER_MODEL?.trim()||process.env.GEMINI_MODEL?.trim()||'gemini-2.5-flash';const prompt=`Deeply inspect this Blox Fruits Treasure Trade screenshot and return ONLY JSON. Inspect ONLY the central TREASURE TRADE panel. Ignore inventory, hotbar, abilities, background, avatars, chat, HUD and countdown numbers. LEFT is ALWAYS the screenshot uploader; RIGHT is ALWAYS the other trader. Inspect every occupied trade slot one by one, top-to-bottom and left-to-right. Read the green item-name text first and cross-check the artwork. Count duplicate slots exactly. Never use the displayed Beli price as trade value. Distinguish special variants including Yellow Lightning, Green Lightning and Red Lightning. permanent=true only if clearly permanent. Empty + slots are not items. Never invent an item. Normalize spelling to the closest exact canonical catalog name; if uncertain keep the closest visible name with confidence below 0.70. Do not calculate value, demand, or W/F/L. Canonical catalog: ${catalog} Output exactly {"left":[{"name":"Venom","quantity":1,"permanent":false,"confidence":0.99}],"right":[]}.`;
const r=await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${encodeURIComponent(model)}:generateContent`,{method:'POST',headers:{'content-type':'application/json','x-goog-api-key':key},body:JSON.stringify({contents:[{role:'user',parts:[{text:prompt},{inlineData:{mimeType:img.mime,data:img.data}}]}],generationConfig:{temperature:0,maxOutputTokens:1800,responseMimeType:'application/json'}})});const raw=await r.text();if(!r.ok)throw Error(`Gemini ${r.status}: ${raw.slice(0,500)}`);const b=JSON.parse(raw)as any;const text=b.candidates?.[0]?.content?.parts?.map((p:any)=>p.text||'').join('').trim();if(!text)throw Error('Gemini returned no result');return json(text)}
function latest(g:string,u:string):Saved|null{return loadGuild(g).config.bloxScannerScreenshots?.[u]??null}
function save(m:Message,a:Attachment){updateGuild(m.guild!.id,d=>{d.config.bloxScannerScreenshots=d.config.bloxScannerScreenshots??{};d.config.bloxScannerScreenshots[m.author.id]={url:a.url,messageId:m.id,createdAt:Date.now()}})}
async function scan(m:Message,url:string){const st=await m.reply('🔎 **Scanning screenshot...** Deep-identifying every trade slot and matching values + demand.');try{const res=await analyze(url);if(!res.left.length&&!res.right.length){await st.edit('❌ No trade items detected. Please upload the full Treasure Trade window.');return}await st.edit({content:'',embeds:[embed(m.author.id,res)]})}catch(e){console.error('[BloxScanner]',e);await st.edit('❌ **Deep scan failed.** Check the Gemini API key/Render logs and try again with the full trade window.')}}
export const bloxscanner:Command={data:new SlashCommandBuilder().setName('bloxscanner').setDescription('Blox Fruits W/F/L screenshot scanner').addSubcommand(s=>s.setName('enable').setDescription('Enable scanner in this channel')).addSubcommand(s=>s.setName('disable').setDescription('Disable scanner')).addSubcommand(s=>s.setName('status').setDescription('Show scanner channel')).addSubcommand(s=>s.setName('scan').setDescription('Scan latest screenshot')),async execute(i){if(!i.guildId){await i.reply({content:'❌ Server only.',ephemeral:true});return}const sub=i.options.getSubcommand();if(sub==='status'){const id=loadGuild(i.guildId).config.bloxScannerChannelId;await i.reply(id?`🔎 Scanner: <#${id}>`:'🔎 Scanner is disabled.');return}const ok=i.guild?.ownerId===i.user.id||i.memberPermissions?.has(PermissionFlagsBits.ManageGuild)||i.memberPermissions?.has(PermissionFlagsBits.Administrator);if(sub==='enable'||sub==='disable'){if(!ok){await i.reply({content:'❌ Manage Server required.',ephemeral:true});return}updateGuild(i.guildId,d=>{d.config.bloxScannerChannelId=sub==='enable'?i.channelId:undefined});await i.reply(sub==='enable'?`🔎 **Scanner enabled in <#${i.channelId}>.** Upload a screenshot and it scans automatically.`:'🔎 **Scanner disabled.**');return}const ch=loadGuild(i.guildId).config.bloxScannerChannelId;if(ch&&ch!==i.channelId){await i.reply({content:`❌ Use <#${ch}>.`,ephemeral:true});return}const saved=latest(i.guildId,i.user.id);if(!saved){await i.reply({content:'❌ Upload a screenshot first.',ephemeral:true});return}await i.deferReply();try{await i.editReply({embeds:[embed(i.user.id,await analyze(saved.url))]})}catch{await i.editReply('❌ Deep scan failed. Check Gemini API key/Render logs.')}}};
export function registerBloxScannerEvents(client:Client){if((client as any)[KEY])return;(client as any)[KEY]=true;client.on(Events.MessageCreate,async m=>{try{if(m.author.bot||!m.guild)return;const ch=loadGuild(m.guild.id).config.bloxScannerChannelId;if(!ch||ch!==m.channelId)return;const a=[...m.attachments.values()].find(image);if(a){if(!(await claimMessageEvent(`bloxscanner:image:${m.id}`)))return;save(m,a);await scan(m,a.url);return}if(ss(m.content)){if(!(await claimMessageEvent(`bloxscanner:ss:${m.id}`)))return;const s=latest(m.guild.id,m.author.id);if(!s){await m.reply('❌ Upload a trade screenshot first.');return}await scan(m,s.url)}}catch(e){console.error('[BloxScanner] message:',e)}})}
